{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Easy Archive Assistant manifest v1 / 清单结构（兼容 ArchiveFlow）",
  "description": "Structural validation is not content or provenance verification. Also call Manifest::validate for range, count and naming invariants.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tool", "original_filename", "original_size", "original_sha256", "split_mode", "part_count", "parts", "created_at", "app_version"],
  "properties": {
    "schema_version": {"const": 1},
    "tool": {"type": "string", "minLength": 1, "maxLength": 64},
    "original_filename": {"$ref": "#/$defs/basename"},
    "original_size": {"$ref": "#/$defs/u64"},
    "original_sha256": {"$ref": "#/$defs/hash"},
    "split_mode": {"enum": ["hard", "balanced"]},
    "part_count": {"type": "integer", "minimum": 1, "maximum": 10000},
    "parts": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"$ref": "#/$defs/part"}},
    "created_at": {"type": "string", "format": "date-time"},
    "app_version": {"type": "string", "minLength": 1, "maxLength": 64}
  },
  "$defs": {
    "u64": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "basename": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "^[^<>:\"/\\\\|?*\\u0000-\\u001f]+$", "description": "Runtime validator additionally rejects reserved Windows device names, trailing dot/space, dot traversal, controls and excessive UTF-16 length."},
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "filename", "offset", "size", "sha256"],
      "properties": {
        "index": {"type": "integer", "minimum": 1, "maximum": 10000},
        "filename": {"$ref": "#/$defs/basename"},
        "offset": {"$ref": "#/$defs/u64"},
        "size": {"$ref": "#/$defs/u64"},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
